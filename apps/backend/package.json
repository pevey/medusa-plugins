{
	"name": "backend",
	"private": true,
	"description": "A test server for developing and testing Medusa plugins.",
	"scripts": {
		"build": "medusa build && cp -R tax-data .medusa/server && cp -R static .medusa/server && cp .env .medusa/server",
		"db:migrate": "medusa db:migrate",
		"db:generate": "medusa db:generate",
		"preview:emails": "email dev --dir ./src/templates",
		"predev": "node ../../scripts/dedupe-medusa.cjs",
		"dev": "medusa develop",
		"lint": "medusa lint",
		"start": "medusa start"
	},
	"dependencies": {
		"@medusajs/admin-sdk": "2.18.0",
		"@medusajs/cli": "2.18.0",
		"@medusajs/framework": "2.18.0",
		"@medusajs/index": "2.18.0",
		"@medusajs/medusa": "2.18.0",
		"medusa-plugin-access": "workspace:*",
		"medusa-plugin-affiliates": "workspace:*",
		"medusa-plugin-analytics": "workspace:*",
		"medusa-plugin-automation": "workspace:*",
		"medusa-plugin-barcodes": "workspace:*",
		"medusa-plugin-braintree": "workspace:*",
		"medusa-plugin-complaints": "workspace:*",
		"medusa-plugin-content": "workspace:*",
		"medusa-plugin-customer-tags": "workspace:*",
		"medusa-plugin-forms": "workspace:*",
		"medusa-plugin-mcp": "workspace:*",
		"medusa-plugin-order-notes": "workspace:*",
		"medusa-plugin-r2": "workspace:*",
		"medusa-plugin-ratings": "workspace:*",
		"medusa-plugin-search": "workspace:*",
		"medusa-plugin-ses": "workspace:*",
		"medusa-plugin-statistics": "workspace:*",
		"medusa-plugin-tax-lookup": "workspace:*",
		"medusa-plugin-tracing": "workspace:*",
		"medusa-plugin-veeqo": "workspace:*"
	},
	"devDependencies": {
		"@react-email/ui": "6.9.1",
		"@swc/core": "1.15.47",
		"@swc/jest": "0.2.39",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/jest": "30.0.0",
		"@types/node": "22.20.1",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"@vitejs/plugin-react": "6.0.4",
		"happy-dom": "20.11.1",
		"jest": "29.7.0",
		"msw": "2.15.0",
		"prop-types": "15.8.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-email": "6.9.1",
		"ts-node": "10.9.2",
		"tsx": "4.23.1",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"vitest": "4.1.10",
		"yalc": "1.0.0-pre.53"
	},
	"engines": {
		"node": ">=22"
	}
}
