{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "theme-button",
  "title": "Theme Button",
  "type": "registry:ui",
  "description": "Icon button that toggles light/dark via mode-watcher. Resizable, with overridable sun/moon icons.",
  "dependencies": [
    "mode-watcher",
    "@lucide/svelte"
  ],
  "registryDependencies": [
    "button"
  ],
  "files": [
    {
      "content": "<script lang=\"ts\">\n\timport { mode, toggleMode } from 'mode-watcher'\n\timport { cn } from '$UTILS$.js'\n\timport SunIcon from '@lucide/svelte/icons/sun'\n\timport MoonIcon from '@lucide/svelte/icons/moon'\n\timport type { Snippet } from 'svelte'\n\n\tinterface Props {\n\t\tclass?: string\n\t\tsun?: Snippet\n\t\tmoon?: Snippet\n\t}\n\tlet { class: className = '', sun, moon }: Props = $props()\n\tconst isLight = $derived(mode.current !== 'dark')\n</script>\n\n<button type=\"button\" onclick={toggleMode} class={cn('inline-flex cursor-pointer items-center', className)} aria-label=\"Toggle theme\">\n\t{#if isLight}\n\t\t{#if sun}{@render sun()}{:else}<SunIcon class=\"size-8\" />{/if}\n\t{:else if moon}{@render moon()}{:else}<MoonIcon class=\"size-8\" />{/if}\n\t<span class=\"sr-only\">Toggle theme</span>\n</button>\n",
      "type": "registry:ui",
      "target": "theme/theme-button.svelte"
    }
  ]
}
