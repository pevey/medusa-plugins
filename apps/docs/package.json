{
	"name": "docs",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"generate:openapi": "node scripts/generate-openapi.mjs",
		"sync:readmes": "node scripts/sync-readmes.mjs",
		"sync:registry": "node scripts/sync-registry.mjs",
		"deploy": "wrangler pages deploy dist --commit-dirty=true",
		"dev": "node scripts/sync-readmes.mjs && astro dev",
		"build": "node scripts/generate-openapi.mjs && node scripts/sync-readmes.mjs && node scripts/sync-registry.mjs && astro build",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/starlight": "0.41.4",
		"@astrojs/starlight-tailwind": "5.0.0",
		"@fontsource/inter": "5.3.0",
		"@fontsource/roboto-mono": "5.3.0",
		"@tailwindcss/vite": "4.3.3",
		"astro": "7.1.3",
		"starlight-llms-txt": "0.11.0",
		"starlight-openapi": "0.26.0",
		"tailwindcss": "4.3.3",
		"vite": "8.1.5",
		"yaml": "2.9.0"
	},
	"installConfig": {
		"hoistingLimits": "workspaces"
	}
}
