{
	"name": "medusa-plugin-search",
	"version": "1.0.0",
	"description": "Typo-tolerant search for Medusa v2 on existing Postgres database using pg_trgm.",
	"author": "Lacey Pevey",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pevey/medusa-plugins.git"
	},
	"homepage": "https://pevey.com/medusa-plugin-search",
	"files": [
		".medusa/server"
	],
	"exports": {
		"./package.json": "./package.json",
		"./.medusa/server/src/modules/*": {
			"types": "./.medusa/server/src/modules/*/index.d.ts",
			"default": "./.medusa/server/src/modules/*/index.js"
		},
		"./modules/*": {
			"types": "./.medusa/server/src/modules/*/index.d.ts",
			"default": "./.medusa/server/src/modules/*/index.js"
		},
		"./*": {
			"types": "./.medusa/server/src/*.d.ts",
			"default": "./.medusa/server/src/*.js"
		},
		".": {
			"types": "./.medusa/server/src/index.d.ts",
			"default": "./.medusa/server/src/index.js"
		}
	},
	"keywords": [
		"medusa-v2",
		"medusa",
		"search",
		"pg_trgm",
		"full-text-search",
		"typo-tolerant"
	],
	"scripts": {
		"build": "medusa plugin:build",
		"db:generate": "medusa plugin:db:generate && yarn build",
		"clean:snapshots": "find . -name '.snapshot-*.json' -path '*/migrations/*' -delete",
		"dev": "medusa plugin:develop",
		"prepublishOnly": "medusa plugin:build",
		"test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --detectOpenHandles --forceExit --passWithNoTests",
		"test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --detectOpenHandles --forceExit"
	},
	"devDependencies": {
		"@medusajs/cli": "2.17.2",
		"@medusajs/framework": "2.17.2",
		"@medusajs/test-utils": "2.17.2",
		"@swc/core": "1.15.33",
		"@swc/jest": "0.2.39",
		"@types/jest": "30.0.0",
		"@types/node": "20.0.0",
		"jest": "29.7.0",
		"ts-node": "10.9.2",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"@medusajs/framework": "2.17.2",
		"@medusajs/js-sdk": "2.17.2",
		"@medusajs/medusa": "2.17.2"
	},
	"engines": {
		"node": ">=20"
	},
	"gitHead": "4ec3aeec50258fb700d4eb70582dbbef7f2874aa"
}