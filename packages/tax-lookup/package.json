{
	"name": "medusa-plugin-tax-lookup",
	"version": "0.2.2",
	"description": "Tax rate lookup provider for Medusa v2",
	"author": "Lacey Pevey",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pevey/medusa-plugins.git"
	},
	"homepage": "https://pevey.com/medusa-plugin-tax-lookup",
	"files": [
		".medusa/server"
	],
	"exports": {
		"./package.json": "./package.json",
		"./.medusa/server/src/modules/*": {
			"types": "./.medusa/server/src/modules/*/index.d.ts",
			"default": "./.medusa/server/src/modules/*/index.js"
		},
		"./modules/*": {
			"types": "./.medusa/server/src/modules/*/index.d.ts",
			"default": "./.medusa/server/src/modules/*/index.js"
		},
		"./providers/*": {
			"types": "./.medusa/server/src/providers/*/index.d.ts",
			"default": "./.medusa/server/src/providers/*/index.js"
		},
		"./*": {
			"types": "./.medusa/server/src/*.d.ts",
			"default": "./.medusa/server/src/*.js"
		},
		".": {
			"types": "./.medusa/server/src/providers/tax-lookup/index.d.ts",
			"default": "./.medusa/server/src/providers/tax-lookup/index.js"
		}
	},
	"keywords": [
		"medusa-plugin-tax",
		"medusa-v2",
		"medusa",
		"tax",
		"tax-lookup",
		"tax provider"
	],
	"scripts": {
		"build": "medusa plugin:build",
		"db:generate": "medusa plugin:db:generate && yarn build",
		"dev": "medusa plugin:develop",
		"prepublishOnly": "medusa plugin:build",
		"test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --detectOpenHandles --forceExit --passWithNoTests"
	},
	"devDependencies": {
		"@medusajs/admin-sdk": "2.18.0",
		"@medusajs/cli": "2.18.0",
		"@medusajs/framework": "2.18.0",
		"@medusajs/icons": "2.18.0",
		"@medusajs/ui": "4.1.19",
		"@swc/core": "1.15.46",
		"@swc/jest": "0.2.39",
		"@types/jest": "30.0.0",
		"@types/node": "22.20.1",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"jest": "29.7.0",
		"prop-types": "15.8.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"yalc": "1.0.0-pre.53"
	},
	"peerDependencies": {
		"@medusajs/framework": "^2.17.2",
		"@medusajs/js-sdk": "^2.17.2",
		"@medusajs/medusa": "^2.17.2"
	},
	"engines": {
		"node": ">=22"
	}
}
