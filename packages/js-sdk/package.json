{
	"name": "@pevey/medusa-sdk",
	"version": "2.17.2-d",
	"description": "Extended Medusa JS SDK with custom plugin support",
	"author": "Lacey Pevey",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/pevey/medusa-plugins"
	},
	"homepage": "https://pevey.com/medusa-sdk",
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc && tsc-alias",
		"dev": "tsc --watch & tsc-alias --watch",
		"prepublishOnly": "tsc && tsc-alias"
	},
	"dependencies": {
		"@medusajs/js-sdk": "2.17.2",
		"@medusajs/types": "2.17.2"
	},
	"devDependencies": {
		"tsc-alias": "^1.9.0",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": ">=18"
	},
	"gitHead": "4ec3aeec50258fb700d4eb70582dbbef7f2874aa"
