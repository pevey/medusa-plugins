{
	"name": "medusa-plugin-access",
	"version": "0.1.2",
	"description": "Access management for Medusa v2.",
	"author": "Lacey Pevey",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pevey/medusa-plugins.git"
	},
	"homepage": "https://pevey.com/medusa-plugin-access",
	"keywords": [],
	"files": [
		".medusa/server"
	],
	"exports": {
		".": {
			"types": "./.medusa/server/src/index.d.ts",
			"default": "./.medusa/server/src/index.js"
		},
		"./package.json": "./package.json",
		"./.medusa/server/src/modules/*": {
			"types": "./.medusa/server/src/modules/*/index.d.ts",
			"default": "./.medusa/server/src/modules/*/index.js"
		},
		"./modules/*": {
			"types": "./.medusa/server/src/modules/*/index.d.ts",
			"default": "./.medusa/server/src/modules/*/index.js"
		},
		"./utils": {
			"types": "./.medusa/server/src/utils/index.d.ts",
			"default": "./.medusa/server/src/utils/index.js"
		},
		"./utils/*": {
			"types": "./.medusa/server/src/utils/*.d.ts",
			"default": "./.medusa/server/src/utils/*.js"
		},
		"./workflows": {
			"types": "./.medusa/server/src/workflows/index.d.ts",
			"default": "./.medusa/server/src/workflows/index.js"
		},
		"./*": {
			"types": "./.medusa/server/src/*.d.ts",
			"default": "./.medusa/server/src/*.js"
		}
	},
	"scripts": {
		"build": "medusa plugin:build",
		"db:generate": "medusa plugin:db:generate && yarn build",
		"clean:snapshots": "find . -name '.snapshot-*.json' -path '*/migrations/*' -delete",
		"dev": "medusa plugin:develop",
		"prepublishOnly": "medusa plugin:build",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.integration.json && tsc -p tsconfig.admin.json",
		"test:admin": "vitest run",
		"test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --detectOpenHandles --forceExit --passWithNoTests",
		"test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --detectOpenHandles --forceExit"
	},
	"devDependencies": {
		"@medusajs/admin-sdk": "2.18.0",
		"@medusajs/cli": "2.18.0",
		"@medusajs/framework": "2.18.0",
		"@medusajs/icons": "2.18.0",
		"@medusajs/ui": "4.2.0",
		"@swc/core": "1.15.47",
		"@swc/jest": "0.2.39",
		"@types/jest": "30.0.0",
		"@types/node": "22.20.1",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"jest": "29.7.0",
		"medusa-admin-test-utils": "workspace:*",
		"prop-types": "15.8.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"@medusajs/framework": "^2.17.2",
		"@medusajs/js-sdk": "^2.17.2",
		"@medusajs/medusa": "^2.17.2"
	},
	"engines": {
		"node": ">=22"
	}
}
