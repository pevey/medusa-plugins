{
	"name": "medusa-plugin-mcp",
	"version": "0.3.0",
	"description": "MCP server and LLM chat plugin for Medusa v2",
	"author": "Lacey Pevey",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pevey/medusa-plugins.git"
	},
	"homepage": "https://pevey.com/medusa-plugin-mcp",
	"files": [
		".medusa/server"
	],
	"exports": {
		"./package.json": "./package.json",
		"./admin": {
			"import": "./.medusa/server/src/admin/index.mjs",
			"require": "./.medusa/server/src/admin/index.js",
			"default": "./.medusa/server/src/admin/index.js"
		},
		"./.medusa/server/src/modules/*": {
			"types": "./.medusa/server/src/modules/*/index.d.ts",
			"default": "./.medusa/server/src/modules/*/index.js"
		},
		"./modules/*": {
			"types": "./.medusa/server/src/modules/*/index.d.ts",
			"default": "./.medusa/server/src/modules/*/index.js"
		},
		"./providers/*": {
			"types": "./.medusa/server/src/providers/*/index.d.ts",
			"default": "./.medusa/server/src/providers/*/index.js"
		},
		"./*": {
			"types": "./.medusa/server/src/*.d.ts",
			"default": "./.medusa/server/src/*.js"
		},
		".": {
			"types": "./.medusa/server/src/modules/mcp/index.d.ts",
			"default": "./.medusa/server/src/modules/mcp/index.js"
		}
	},
	"keywords": [
		"medusa-v2",
		"medusa",
		"mcp",
		"chat",
		"ai",
		"llm",
		"model-context-protocol"
	],
	"scripts": {
		"build": "medusa plugin:build",
		"db:generate": "medusa plugin:db:generate && yarn build",
		"dev": "medusa plugin:develop",
		"prepublishOnly": "medusa plugin:build",
		"test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --detectOpenHandles --forceExit",
		"test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.51.0",
		"@modelcontextprotocol/sdk": "1.29.0",
		"openai": "4.98.0",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1"
	},
	"devDependencies": {
		"@medusajs/admin-sdk": "2.17.2",
		"@medusajs/cli": "2.17.2",
		"@medusajs/framework": "2.17.2",
		"@medusajs/icons": "2.17.2",
		"@medusajs/test-utils": "2.17.2",
		"@medusajs/ui": "4.1.19",
		"@swc/core": "1.15.33",
		"@swc/jest": "0.2.39",
		"@types/jest": "30.0.0",
		"@types/node": "20.0.0",
		"@types/react": "18.3.2",
		"@types/react-dom": "18.2.25",
		"jest": "29.7.0",
		"medusa-plugin-automation": "0.3.2",
		"medusa-plugin-statistics": "0.2.2",
		"prop-types": "15.8.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"typescript": "6.0.3",
		"vite": "8.1.5"
	},
	"peerDependencies": {
		"@medusajs/framework": "2.17.2",
		"@medusajs/js-sdk": "2.17.2",
		"@medusajs/medusa": "2.17.2",
		"medusa-plugin-automation": "*",
		"medusa-plugin-statistics": "*"
	},
	"peerDependenciesMeta": {
		"medusa-plugin-automation": {
			"optional": true
		},
		"medusa-plugin-statistics": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=20"
	},
	"gitHead": "4ec3aeec50258fb700d4eb70582dbbef7f2874aa"
}