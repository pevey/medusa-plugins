{
	"name": "medusa-plugin-complaints",
	"version": "1.1.0",
	"description": "Complaint logger plugin for Medusa v2",
	"author": "Lacey Pevey",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pevey/medusa-plugins.git"
	},
	"homepage": "https://pevey.com/medusa-plugin-complaints",
	"files": [
		".medusa/server"
	],
	"exports": {
		"./package.json": "./package.json",
		"./admin": {
			"import": "./.medusa/server/src/admin/index.mjs",
			"require": "./.medusa/server/src/admin/index.js",
			"default": "./.medusa/server/src/admin/index.js"
		},
		"./.medusa/server/src/modules/*": {
			"types": "./.medusa/server/src/modules/*/index.d.ts",
			"default": "./.medusa/server/src/modules/*/index.js"
		},
		"./modules/*": {
			"types": "./.medusa/server/src/modules/*/index.d.ts",
			"default": "./.medusa/server/src/modules/*/index.js"
		},
		"./providers/*": {
			"types": "./.medusa/server/src/providers/*/index.d.ts",
			"default": "./.medusa/server/src/providers/*/index.js"
		},
		"./*": {
			"types": "./.medusa/server/src/*.d.ts",
			"default": "./.medusa/server/src/*.js"
		},
		".": {
			"types": "./.medusa/server/src/modules/complaint/index.d.ts",
			"default": "./.medusa/server/src/modules/complaint/index.js"
		}
	},
	"keywords": [
		"medusa-v2",
		"medusa",
		"complaints",
		"complaint logging",
		"complaint management",
		"customer complaints",
		"complaint tracking"
	],
	"scripts": {
		"build": "medusa plugin:build",
		"db:generate": "medusa plugin:db:generate && yarn build",
		"clean:snapshots": "find . -name '.snapshot-*.json' -path '*/migrations/*' -delete",
		"dev": "medusa plugin:develop",
		"prepublishOnly": "medusa plugin:build",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.unit.json && tsc -p tsconfig.admin.json",
		"test:admin": "vitest run",
		"test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --detectOpenHandles --forceExit --passWithNoTests",
		"test:integration:http": "yarn --cwd ../access build && TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --detectOpenHandles --forceExit"
	},
	"devDependencies": {
		"@medusajs/admin-sdk": "2.18.0",
		"@medusajs/cli": "2.18.0",
		"@medusajs/framework": "2.18.0",
		"@medusajs/icons": "2.18.0",
		"@medusajs/ui": "4.2.0",
		"@swc/core": "1.15.47",
		"@swc/jest": "0.2.39",
		"@types/jest": "30.0.0",
		"@types/node": "22.20.1",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"jest": "29.7.0",
		"medusa-admin-test-utils": "workspace:*",
		"medusa-plugin-access": "workspace:*",
		"prop-types": "15.8.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"vitest": "4.1.10",
		"yalc": "1.0.0-pre.53"
	},
	"peerDependencies": {
		"@medusajs/framework": "^2.18.0",
		"@medusajs/js-sdk": "^2.18.0",
		"@medusajs/medusa": "^2.18.0",
		"medusa-plugin-access": "*"
	},
	"peerDependenciesMeta": {
		"medusa-plugin-access": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"jimp": "^1.6.1",
		"pdf-lib": "^1.17.1"
	}
}
