{
  "name": "@pevey/sveltekit-medusa-sdk",
  "version": "0.0.0",
  "description": "SvelteKit remote-function client for a Medusa v2 backend",
  "author": "Lacey Pevey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pevey/medusa-plugins"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ping": {
      "types": "./dist/ping.remote.d.ts",
      "svelte": "./dist/ping.remote.js",
      "default": "./dist/ping.remote.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "lint": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.22.0",
    "svelte": "^5.36.0"
  },
  "dependencies": {
    "@pevey/medusa-sdk": "workspace:*",
    "cookie": "^1.0.0",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "publint": "^0.3.0",
    "svelte": "^5.36.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
