{
	"name": "sveltekit-medusa-sdk",
	"version": "0.6.0",
	"description": "SvelteKit remote-function client for a Medusa v2 backend",
	"author": "Lacey Pevey",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/pevey/medusa-plugins"
	},
	"homepage": "https://pevey.com/sveltekit-medusa-sdk",
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./schemas": {
			"types": "./dist/schemas/index.d.ts",
			"svelte": "./dist/schemas/index.js",
			"default": "./dist/schemas/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"svelte": "./dist/server/index.js",
			"default": "./dist/server/index.js"
		},
		"./*": {
			"types": "./dist/*.remote.d.ts",
			"svelte": "./dist/*.remote.js",
			"default": "./dist/*.remote.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest run",
		"lint": "svelte-check --tsconfig ./tsconfig.json"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.22.0",
		"svelte": "^5.36.0"
	},
	"dependencies": {
		"@medusajs/types": "^2.17.2",
		"@pevey/medusa-sdk": "workspace:*",
		"cookie": "^1.0.0",
		"valibot": "^1.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/package": "^2.3.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"publint": "^0.3.0",
		"svelte": "^5.36.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.5.0",
		"vite": "^7.0.0",
		"vitest": "^3.0.0"
	}
}